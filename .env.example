# Referência de variáveis do processo da API.
# O projeto não carrega este arquivo automaticamente.
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
DATABASE_PATH=var/driver-food.sqlite

# Salve como apps/web/.env.local para impedir fallback de leitura mock no desenvolvimento.
VITE_ENABLE_MOCK_FALLBACK=false
# Opcional: destino do proxy /api no servidor Vite.
VITE_API_TARGET=http://localhost:3333
